# Chat Trigger webhook URL from the "RAG Query Workflow" (workflow 2NRRzQ65Z3wyJ4Lv).
# Best-guess production form based on the node's webhookId — verify/copy the exact
# URL from the Chat Trigger node in the n8n editor (it has its own "chat URL" shown
# in the node panel) before relying on this.
VITE_CHAT_WEBHOOK_URL=https://n8n.filheinzrelatorre.com/webhook/3d0b43af-45fb-436b-ace4-c668bdf7c8a5/chat

# Ingestion workflow webhook (workflow s9IXTHWiPsEdFrrj). Confirmed exact path.
# Requires that workflow to be activated in n8n, otherwise use the webhook-test
# variant while iterating: https://n8n.filheinzrelatorre.com/webhook-test/upload-document
VITE_UPLOAD_WEBHOOK_URL=https://n8n.filheinzrelatorre.com/webhook/upload-document

# "List documents" workflow — returns the documents already ingested into the
# knowledge base, for the /library page. Requires that workflow to be
# activated (and its credentials configured) in n8n.
VITE_LIST_DOCUMENTS_URL=https://n8n.filheinzrelatorre.com/webhook/list-documents

# "Dashboard stats" workflow — aggregates query_logs (Neon) into summary
# stats, daily volume, and recent queries for the /dashboard page. Requires
# that workflow to be activated and published in n8n.
VITE_DASHBOARD_STATS_URL=https://n8n.filheinzrelatorre.com/webhook/dashboard-stats
