        "postgres": {
          "id": "vpxcyopVxuS0Ln4s",
          "name": "RAG Neon"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS cnt FROM users WHERE email = $1;",
        "options": {
          "queryReplacement": "={{ [$('Signup Webhook').item.json.body.email] }}"
