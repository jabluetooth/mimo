      "parameters": {
        "method": "POST",
        "url": "https://router.huggingface.co/hf-inference/models/sentence-transformers/all-mpnet-base-v2",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "huggingFaceApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"inputs\": { \"source_sentence\": $(\"Normalize Question\").item.json.question, \"sentences\": $input.all().map(i => i.json.document.pageContent) } } }}",
