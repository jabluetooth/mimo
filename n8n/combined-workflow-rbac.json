      "id": "0679c6f3-1595-4eaa-921d-8bb80a278c0e",
      "name": "Scroll Qdrant Points",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        1264
      ],
      "credentials": {
        "httpHeaderAuth": {
