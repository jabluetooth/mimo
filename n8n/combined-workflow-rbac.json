      "id": "0f85e472-815e-4c1d-9bf6-34aa4ba16549",
      "name": "Rerank with HuggingFace",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1248,
        176
      ],
      "executeOnce": true,
      "credentials": {
        "httpBearerAuth": {
          "id": "8R0KIZW3bgzKz19K",
          "name": "ZeroPress"
        },
        "huggingFaceApi": {
          "id": "E6JDQAYv67yFmCcj",
          "name": "RAG"
        }
      }
