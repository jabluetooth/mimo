    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object(\n  'summary', (\n    SELECT json_build_object(\n      'total', count(*),\n      'answered', count(*) FILTER (WHERE outcome = 'answered'),\n      'refused', count(*) FILTER (WHERE outcome = 'refused'),\n      'refusalRate', round((count(*) FILTER (WHERE outcome = 'refused'))::numeric / GREATEST(count(*), 1), 4),\n      'avgLatencyMs', round(avg(latency_ms)),\n      'p50LatencyMs', round(percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms)),\n      'p95LatencyMs', round(percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms)),\n      'avgConfidence', round(avg(confidence_score)::numeric, 4)\n    )\n    FROM query_logs\n  ),\n  'daily', (\n    SELECT COALESCE(json_agg(d ORDER BY d.day), '[]'::json)\n    FROM (\n      SELECT\n        to_char(date_trunc('day', created_at), 'YYYY-MM-DD') AS day,\n        count(*) AS total,\n        count(*) FILTER (WHERE outcome = 'refused') AS refused\n      FROM query_logs\n      WHERE created_at > now() - interval '30 days'\n      GROUP BY 1\n    ) d\n  ),\n  'recent', (\n    SELECT COALESCE(json_agg(r), '[]'::json)\n    FROM (\n      SELECT created_at, question, outcome, confidence_score, latency_ms\n      FROM query_logs\n      ORDER BY created_at DESC\n      LIMIT 20\n    ) r\n  )\n) AS stats;",
        "options": {}
      },
