    {
      "parameters": {
        "jsCode": "const NL = String.fromCharCode(10);\nconst raw = $input.first().json;\nlet scores;\nif (Array.isArray(raw)) {\n  scores = raw;\n} else if (raw && Array.isArray(raw.data)) {\n  scores = raw.data;\n} else {\n  scores = $input.all().map(function (item) {\n    const v = item.json;\n    if (typeof v === 'number') return v;\n    if (v && typeof v.data === 'number') return v.data;\n    const vals = Object.values(v || {});\n    return typeof vals[0] === 'number' ? vals[0] : 0;\n  });\n}\n\nconst originalChunks = $('Retrieve Candidate Chunks').all().map(i => i.json);\n\n// RBAC: only surface chunks the requester's role is allowed to see. Missing\n// visibility (pre-RBAC ingested docs) defaults to 'member' so nothing already\n// in the knowledge base silently disappears.\nconst requesterRole = $('JWT Verify (Chat)').item.json.payload.role;\nconst allowedVisibilities = requesterRole === 'admin' ? ['member', 'admin'] : ['member'];\n\nconst scored = originalChunks.map(function (chunk, idx) {\n  return {\n    pageContent: chunk.document.pageContent,\n    metadata: chunk.document.metadata || {},\n    relevanceScore: scores[idx] !== undefined ? scores[idx] : 0\n  };\n}).filter(function (chunk) {\n  const visibility = chunk.metadata.visibility || 'member';\n  return allowedVisibilities.indexOf(visibility) !== -1;\n});\n\nscored.sort(function (a, b) { return b.relevanceScore - a.relevanceScore; });\nconst ranked = scored.slice(0, 4);\n\nconst topScore = ranked.length > 0 ? ranked[0].relevanceScore : 0;\n\nconst contextText = ranked.map((c, i) => {\n  const src = c.metadata.source || 'unknown source';\n  const section = c.metadata.section || 'n/a';\n  const updated = c.metadata.updated_at || 'n/a';\n  return '[' + (i + 1) + '] Source: ' + src + ' | Section: ' + section + ' | Last updated: ' + updated + NL + c.pageContent;\n}).join(NL + NL);\n\nconst citations = ranked.map((c, i) => ({\n  marker: '[' + (i + 1) + ']',\n  source: c.metadata.source || 'unknown source',\n  section: c.metadata.section || 'n/a',\n  updatedAt: c.metadata.updated_at || 'n/a',\n  relevanceScore: c.relevanceScore\n}));\n\nconst citationsFormatted = citations.map(c => c.marker + ' ' + c.source + ' (' + c.section + ', updated ' + c.updatedAt + ')').join(NL);\n\nreturn [{ json: { topScore: topScore, contextText: contextText, citations: citations, citationsFormatted: citationsFormatted, chunkCount: ranked.length } }];"
      },
