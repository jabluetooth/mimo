    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst points = (response.result && response.result.points) || [];\n\nconst bySource = {};\nfor (const point of points) {\n  const payload = point.payload || {};\n  const meta = payload.metadata || payload;\n  const source = meta.source || 'unknown source';\n  if (!bySource[source]) {\n    bySource[source] = {\n      source: source,\n      sections: new Set(),\n      updatedAt: meta.updated_at || null,\n      chunkCount: 0\n    };\n  }\n  const entry = bySource[source];\n  entry.chunkCount += 1;\n  if (meta.section) entry.sections.add(meta.section);\n  if (meta.updated_at && (!entry.updatedAt || meta.updated_at > entry.updatedAt)) {\n    entry.updatedAt = meta.updated_at;\n  }\n}\n\nconst documents = Object.values(bySource).map(function (entry) {\n  return {\n    source: entry.source,\n    sectionCount: entry.sections.size,\n    chunkCount: entry.chunkCount,\n    updatedAt: entry.updatedAt\n  };\n}).sort(function (a, b) {\n  return (b.updatedAt || '').localeCompare(a.updatedAt || '');\n});\n\nreturn [{ json: { documents: documents, count: documents.length } }];"
      },
